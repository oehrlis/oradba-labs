# ------------------------------------------------------------------------------
# oradba-labs - dv26 configuration. 'make up LAB=dv26' creates lab.env from
# this file and replaces every CHANGE_ME with a generated password.
# lab.env is git-ignored - never commit it.
# ------------------------------------------------------------------------------
# Image and version - the only place they are set (M2: oradba-docker images).
# Default: Free + OraDBA, built by oracle-free-labs ('make build' there).
DB26_IMAGE=oracle-free-labs
DB26_VERSION=latest
# Host port (bound to 127.0.0.1 only), container memory limit
DB26_PORT=1574
DB26_MEM=3g
# Storage (E9): bind = host directory <LAB_DATA_BASE>/<lab>/<db> (volume: not supported yet, M5)
LAB_STORAGE=bind
LAB_DATA_BASE=~/oradba-labs-data
TZ=Europe/Zurich
# SYS / SYSTEM / PDBADMIN
ORACLE_PWD=CHANGE_ME
# Lab accounts in DVPDB1: LAB_ADMIN (DBA in the PDB), LAB_USER (CREATE SESSION)
LAB_ADMIN_PWD=CHANGE_ME
LAB_USER_PWD=CHANGE_ME
# Common Database Vault accounts C##DV_OWNER / C##DV_ACCTMGR (created by setup, DV configured by the demo)
DV_OWNER_PWD=CHANGE_ME
DV_ACCTMGR_PWD=CHANGE_ME
