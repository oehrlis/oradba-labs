# ------------------------------------------------------------------------------
# oradba-labs - dict19 configuration. 'make snapshot LAB=dict19' creates lab.env
# from this file (CHANGE_ME -> generated password) and deletes it again at the
# end of the run. lab.env is git-ignored - never commit it.
# ------------------------------------------------------------------------------
# Image and version - the only place they are set (M2: oradba-docker image with
# 19.33 + CSPU 2026-11). Target level: common/config/target-levels.env (TARGET_19C_*).
DB19_IMAGE=trivadis/ora_db
DB19_VERSION=19.27.0.0
DB19_SID=CDB19
DB19_PDB=PDB1
# Host port (bound to 127.0.0.1 only), container memory limit
DB19_PORT=1563
DB19_MEM=3g
# Single-use lab: no restore point (LAB_BASELINE), no reset
LAB_BASELINE=none
LAB_STORAGE=bind
LAB_DATA_BASE=~/oradba-labs-data
TZ=Europe/Zurich
# SYS / SYSTEM / PDBADMIN
ORACLE_PWD=CHANGE_ME
