# ------------------------------------------------------------------------------
# oradba-labs - dict26 configuration. 'make snapshot LAB=dict26' creates lab.env
# from this file (CHANGE_ME -> generated password) and deletes it again at the
# end of the run. lab.env is git-ignored - never commit it.
# ------------------------------------------------------------------------------
# Oracle standard Free image, pinned by exact tag (never 'latest'). The target
# level it is measured against: common/config/target-levels.env (TARGET_26AI_*).
DB26_IMAGE=container-registry.oracle.com/database/free
DB26_VERSION=23.26.3.0
# Host port (bound to 127.0.0.1 only), container memory limit
DB26_PORT=1575
DB26_MEM=3g
# Single-use lab: no restore point (LAB_BASELINE), no reset
LAB_BASELINE=none
LAB_STORAGE=bind
LAB_DATA_BASE=~/oradba-labs-data
TZ=Europe/Zurich
# SYS / SYSTEM / PDBADMIN
ORACLE_PWD=CHANGE_ME
