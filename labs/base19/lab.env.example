# ------------------------------------------------------------------------------
# oradba-labs - base19 configuration. 'make up LAB=base19' creates lab.env from
# this file and replaces every CHANGE_ME with a generated password.
# lab.env is git-ignored - never commit it.
# ------------------------------------------------------------------------------
# Image and version - the only place they are set (M2: oradba-docker images)
DB19_IMAGE=trivadis/ora_db
DB19_VERSION=19.27.0.0
# Database
DB19_SID=CDB19
DB19_PDB=PDB1
# Network domain for the container (overrides the image default; the
# databases themselves run without db_domain - services: <pdb>, <sid>)
DB_DOMAIN=lab.local
# Host port (bound to 127.0.0.1 only), container memory limit
DB19_PORT=1561
DB19_MEM=3g
# SYS / SYSTEM / PDBADMIN
ORACLE_PWD=CHANGE_ME
