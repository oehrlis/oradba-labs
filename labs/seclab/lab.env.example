# ------------------------------------------------------------------------------
# oradba-labs - seclab configuration. 'make up LAB=seclab' creates lab.env from
# this file and replaces every CHANGE_ME with a generated password.
# lab.env is git-ignored - never commit it.
# ------------------------------------------------------------------------------
# Images and versions - the only place they are set (M2: oradba-docker images)
DB19_IMAGE=trivadis/ora_db
DB19_VERSION=19.27.0.0
DB26_IMAGE=container-registry.oracle.com/database/free
# latest = 23.26.3 on 2026-11-13; pin a tag once oradba-docker builds it (M2)
DB26_VERSION=latest
# 19c database (26ai Free is always CDB FREE)
DB19_SID=SECDB19
# Network domain for the container (overrides the image default; the
# databases themselves run without db_domain - services: <pdb>, <sid>)
DB_DOMAIN=lab.local
# Host ports (bound to 127.0.0.1 only), container memory limits
DB19_PORT=1562
DB26_PORT=1572
DB19_MEM=3g
DB26_MEM=3g
# SYS / SYSTEM / PDBADMIN (both databases)
ORACLE_PWD=CHANGE_ME
# Lab accounts in DEMOPDB: LAB_ADMIN (DBA in the PDB), LAB_USER (CREATE SESSION)
LAB_ADMIN_PWD=CHANGE_ME
LAB_USER_PWD=CHANGE_ME
