# ------------------------------------------------------------------------------
# oradba-labs - base26 configuration. 'make up LAB=base26' creates lab.env from
# this file and replaces every CHANGE_ME with a generated password.
# lab.env is git-ignored - never commit it.
# ------------------------------------------------------------------------------
# Image and version - the only place they are set (M2: oradba-docker images).
# Default: Free + OraDBA, built by oracle-free-labs ('make build' there).
# Plain Oracle image works as well: container-registry.oracle.com/database/free
DB26_IMAGE=oracle-free-labs
DB26_VERSION=latest
# Host port (bound to 127.0.0.1 only), container memory limit
DB26_PORT=1571
DB26_MEM=3g
# Storage (E9): bind = host directory <LAB_DATA_BASE>/<lab>/<db>, volume = named volume (nocopy)
LAB_STORAGE=bind
LAB_DATA_BASE=~/oradba-labs-data
TZ=Europe/Zurich
# SYS / SYSTEM / PDBADMIN
ORACLE_PWD=CHANGE_ME
